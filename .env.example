# VetCare - example environment (no real values; copy to .env for local work).
# Real values live only in the Vercel project / local .env (CR-019). Never commit them.

# Runtime mode: development | test | production
NODE_ENV=development

# Application origin. Must equal the browser origin that calls the API (CR-021, P05-ASM-017).
# Local development uses the Vite dev server origin.
APP_ORIGIN=http://localhost:5173

# Pooled connection string (Neon pooled endpoint on Vercel). Used by the Express app (CR-024).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Direct (unpooled) connection string. Used ONLY by migrations (CR-024, P05-ASM-015).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Enabled ordering release slices (ADR-017). Comma separated, subset of:
# stock, orders, order_status, order_cancel_owner, order_cancel_provider
# Empty = none enabled (production default, ARCHITECTURE 15.1 item 5).
FEATURES=

# Session lifetimes (TD-05, NFR-005). Defaults shown.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Local API server port (scripts/dev-server.js only; ignored on Vercel).
PORT=3000

# Optional: separate database used only by `npm test` for database tests.
# The tests create and drop their own schema objects there; point it at a throwaway database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vetcare_test
